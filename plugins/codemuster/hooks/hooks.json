{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT,'hooks','context.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|apply_patch|Bash|PowerShell|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT,'hooks','context.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
